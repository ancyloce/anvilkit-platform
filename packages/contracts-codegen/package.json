    "check-m6": "bun run check-m6.ts",
    "check-m7-repository": "bun run check-m7-repository.ts",
    "check-m7-production": "bun run check-m7-production.ts",
    "check-agent-freeze": "bun run check-agent-freeze.ts"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.3",
    "@redocly/cli": "2.46.0",
    "@sigstore/core": "4.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0",
    "jose": "6.2.8",
    "json-schema-to-typescript": "15.0.4",
    "openapi-typescript": "7.13.0"
  }
