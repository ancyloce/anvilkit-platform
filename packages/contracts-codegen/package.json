{
  "name": "@anvilkit/contracts-codegen",
  "version": "0.1.0",
  "private": true,
  "description": "Contract codegen pipeline (EW-CONTRACT-004): validates contracts/ fixtures against the JSON Schemas / OpenAPI documents and generates Go types + thin clients into services/export-worker/contracts/. Tooling only \u2014 never a production service (PRD 0009 Node/TS confinement rule).",
  "type": "module",
  "scripts": {
    "generate": "bun run generate.ts",
    "check-freeze": "bun run check-freeze.ts",
    "check-agent-contracts": "bun run check-agent-contracts.ts",
    "check-agent-specs": "bun run check-agent-specs.ts",
    "check-agent-profile": "bun run check-agent-profile.ts",
    "generate-agent-packages": "bun run generate-agent-packages.ts",
    "emit-typescript-conformance": "bun run emit-typescript-conformance.ts",
    "emit-typescript-identity": "bun run emit-typescript-identity.ts",
    "emit-typescript-signature": "bun run emit-typescript-signature.ts",
    "compare-agent-conformance": "bun run compare-agent-conformance.ts",
    "compare-agent-identity": "bun run compare-agent-identity.ts",
    "compare-agent-signature": "bun run compare-agent-signature.ts",
    "lint-source": "bun run lint-source.ts"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.3",
    "@redocly/cli": "2.46.0",
    "@sigstore/core": "4.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0",
    "jose": "6.2.8",
    "json-schema-to-typescript": "15.0.4",
    "openapi-typescript": "7.13.0"
  }
}
