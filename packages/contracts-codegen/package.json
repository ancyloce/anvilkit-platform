{
  "name": "@anvilkit/contracts-codegen",
  "version": "0.1.0",
  "private": true,
  "description": "Contract codegen pipeline (EW-CONTRACT-004): validates contracts/ fixtures against the JSON Schemas / OpenAPI documents and generates Go types + thin clients into services/export-worker/contracts/. Tooling only — never a production service (PRD 0009 Node/TS confinement rule).",
  "type": "module",
  "scripts": {
    "generate": "bun run generate.ts",
    "check-freeze": "bun run check-freeze.ts",
    "check-m0": "bun run check-m0.ts",
    "benchmark-m0": "bun run benchmark-m0.ts --validate",
    "benchmark-m0-oci": "bun run benchmark-m0-oci.ts",
    "check-m1": "bun run check-m1.ts",
    "check-m2": "bun run check-m2.ts",
    "check-specs": "bun run check-specs.ts",
    "check-m3": "bun run check-m3.ts",
    "check-m4": "bun run check-m4.ts",
    "check-m4-conformance": "bun run check-m4-conformance.ts",
    "compare-m4-conformance": "bun run compare-m4-conformance.ts",
    "compare-m4-identity": "bun run compare-m4-identity.ts",
    "compare-m4-signature": "bun run compare-m4-signature.ts",
    "benchmark-m3-signatures": "bun run benchmark-m3-signatures.ts",
    "check-m4-typescript-generation": "bun run check-m4-typescript-generation.ts",
    "generate-m4-packages": "bun run generate-m4-packages.ts",
    "compose-m4-release-bom": "bun run compose-m4-release-bom.ts",
    "check-m4-generated-packages": "bun run check-m4-generated-packages.ts",
