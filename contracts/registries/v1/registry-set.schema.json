{
  "$schema": "https://contracts.anvilkit.dev/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/schemas/v1/registry-set.schema.json",
  "title": "AnvilKit governed registry set",
  "type": "object",
  "required": ["registrySetVersion", "status", "registries"],
  "properties": {
    "registrySetVersion": {"type":"integer","minimum":1,"maximum":2147483647},
    "status": {"enum":["candidate","frozen","deprecated"]},
    "registries": {"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/registry"}}
  },
  "$defs": {
    "registry": {
      "type":"object",
      "required":["registryId","owner","compatibilityPolicy","entries"],
      "properties":{
        "registryId":{"type":"string","minLength":3,"maxLength":96,"pattern":"^[a-z][a-z0-9-]*[a-z0-9]$"},
        "owner":{"type":"string","minLength":3,"maxLength":128},
        "compatibilityPolicy":{"const":"append-only"},
        "entries":{"type":"array","minItems":1,"maxItems":512,"uniqueItems":true,"items":{"$ref":"#/$defs/entry"}}
      },
      "minProperties":4,
      "maxProperties":4,
      "unevaluatedProperties":false
    },
    "entry": {
      "type":"object",
      "required":["wireValue","meaning","owner","introducedIn","status","aliases","replacement"],
      "properties":{
        "wireValue":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
        "meaning":{"type":"string","minLength":8,"maxLength":512},
        "owner":{"type":"string","minLength":3,"maxLength":128},
        "introducedIn":{"type":"string","minLength":5,"maxLength":32,"pattern":"^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
        "status":{"enum":["active","deprecated","revoked"]},
        "aliases":{"type":"array","minItems":0,"maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}},
        "replacement":{"type":["string","null"],"minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]*$","x-anvilkit-nullSemantics":"null means no replacement is designated"},
        "retryability":{"enum":["never","safe-immediate","safe-after-backoff","after-input","after-approval","after-rebase","operator-action"]}
      },
      "minProperties":7,
      "maxProperties":8,
      "unevaluatedProperties":false,
      "x-anvilkit-omittedSemantics":{"retryability":"absence means the registry is not a problem-code registry"}
    }
  },
  "minProperties":3,
  "maxProperties":3,
  "unevaluatedProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "RegistrySetV1",
    "semanticVersion": "1.0.0",
    "componentName": "anvilkit.contract.registry-set.v1",
    "owner": "Platform Contracts owner",
    "stability": "p0-freeze-candidate",
    "identityFields": ["/registrySetVersion", "/status", "/registries"],
    "maximumSerializedBytes": 524288,
    "compatibilityPolicy": "registry-append-only",
    "descriptions": []
  }
}
