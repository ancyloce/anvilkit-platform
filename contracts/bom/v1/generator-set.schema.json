{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.anvilkit.dev/bom/v1/generator-set.schema.json",
  "title": "GeneratorSetV1",
  "description": "Exact generator and validator identities used by one reproducible binding release.",
  "type": "object",
  "minProperties": 4,
  "maxProperties": 4,
  "required": ["apiVersion", "kind", "version", "entries"],
  "properties": {
    "apiVersion": {"const":"anvilkit.io/contracts/v1"},
    "kind": {"const":"GeneratorSet"},
    "version": {"type":"string","minLength":5,"maxLength":64,"pattern":"^[1-9][0-9]*\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "minProperties": 8,
        "maxProperties": 8,
        "required": ["language", "capability", "name", "version", "digest", "owner", "dependencyCount", "artifactSizeBytes"],
        "properties": {
          "language": {"enum":["go","typescript","python","java","tooling"]},
          "capability": {"type":"string","minLength":3,"maxLength":96,"pattern":"^[a-z0-9][a-z0-9-]*$"},
          "name": {"type":"string","minLength":1,"maxLength":256},
          "version": {"type":"string","minLength":1,"maxLength":128},
          "digest": {"type":"string","minLength":71,"maxLength":71,"pattern":"^sha256:[0-9a-f]{64}$"},
          "owner": {"type":"string","minLength":3,"maxLength":128},
          "dependencyCount": {"type":"integer","minimum":0,"maximum":10000},
          "artifactSizeBytes": {"type":"integer","minimum":1,"maximum":1073741824}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
