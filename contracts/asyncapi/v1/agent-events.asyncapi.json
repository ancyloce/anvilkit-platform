  },
  "operations": {
    "publishRunEvents": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/runEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/runEvents/messages/AgentRun"
        },
        {
          "$ref": "#/channels/runEvents/messages/AgentEvent"
        },
        {
          "$ref": "#/channels/runEvents/messages/ApprovalRequest"
        },
        {
          "$ref": "#/channels/runEvents/messages/InputRequest"
        },
        {
          "$ref": "#/channels/runEvents/messages/AgentArtifact"
        }
      ],
      "description": "Agent Service publishes transactionally ordered run events."
    },
    "consumeRunEvents": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/runEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/runEvents/messages/AgentRun"
        },
        {
          "$ref": "#/channels/runEvents/messages/AgentEvent"
        },
        {
          "$ref": "#/channels/runEvents/messages/ApprovalRequest"
        },
        {
          "$ref": "#/channels/runEvents/messages/InputRequest"
        },
        {
          "$ref": "#/channels/runEvents/messages/AgentArtifact"
        }
      ],
      "description": "Consumers deduplicate event IDs and resnapshot on unexplained sequence gaps."
    },
    "dispatchWorkerTasks": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/workerTasks"
      },
      "messages": [
        {
          "$ref": "#/channels/workerTasks/messages/AgentTask"
        },
        {
          "$ref": "#/channels/workerTasks/messages/WorkerLease"
        }
      ],
      "description": "Scheduler dispatches a task and distinct fenced lease."
    },
    "consumeWorkerTasks": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/workerTasks"
      },
      "messages": [
        {
          "$ref": "#/channels/workerTasks/messages/AgentTask"
        },
        {
          "$ref": "#/channels/workerTasks/messages/WorkerLease"
        }
      ],
      "description": "Workers validate task and lease under the pinned BOM."
    },
    "publishWorkerResults": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/workerResults"
      },
      "messages": [
        {
          "$ref": "#/channels/workerResults/messages/WorkerResult"
        }
      ],
      "description": "Workers publish state-changing results with the full fence tuple."
    },
    "consumeWorkerResults": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/workerResults"
      },
      "messages": [
        {
          "$ref": "#/channels/workerResults/messages/WorkerResult"
        }
      ],
      "description": "Scheduler accepts state only through a current-fence compare-and-set."
    },
    "publishUsage": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/usageObservations"
      },
      "messages": [
        {
          "$ref": "#/channels/usageObservations/messages/UsageObservation"
        }
      ],
      "description": "Every physical attempt emits additive observations."
    },
    "consumeUsage": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/usageObservations"
      },
      "messages": [
        {
          "$ref": "#/channels/usageObservations/messages/UsageObservation"
        }
      ],
      "description": "Pagix deduplicates observations independently of result eligibility."
    },
    "consumeDlq": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/dlq"
      },
      "messages": [
        {
          "$ref": "#/channels/dlq/messages/ProblemDetails"
        }
      ],
      "description": "Operators receive bounded stable problems carrying stage, run, and trace."
    }
  },
