{
  "asyncapi": "3.1.0",
  "info": {
    "title": "AnvilKit Agent events",
    "version": "1.0.0",
    "description": "Candidate Kafka binding; producer and consumer owner acknowledgement is pending.",
    "x-anvilkit-ownerAcknowledgement": "pending"
  },
  "defaultContentType": "application/json",
  "servers": {
    "candidateKafka": {
      "host": "kafka.internal.anvilkit.dev:9092",
      "protocol": "kafka",
      "description": "Candidate Agent event transport.",
      "x-anvilkit-ownerAcknowledgement": "pending"
    }
  },
  "channels": {
    "runEvents": {
      "address": "anvilkit.agent.run-events.v1",
      "messages": {
        "AgentRun": {
          "$ref": "#/components/messages/AgentRun"
        },
        "AgentEvent": {
          "$ref": "#/components/messages/AgentEvent"
        },
        "ApprovalRequest": {
          "$ref": "#/components/messages/ApprovalRequest"
        },
        "InputRequest": {
          "$ref": "#/components/messages/InputRequest"
        },
        "AgentArtifact": {
          "$ref": "#/components/messages/AgentArtifact"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "runId",
      "x-anvilkit-delivery": "at-least-once"
    },
    "workerTasks": {
      "address": "anvilkit.agent.worker-tasks.v1",
