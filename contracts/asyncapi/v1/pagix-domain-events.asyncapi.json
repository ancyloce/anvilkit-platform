{
  "asyncapi": "3.1.0",
  "info": {
    "title": "Pagix domain events for Agent workflows",
    "version": "1.0.0",
    "description": "Kafka-bound Pagix business events and additive usage observations."
  },
  "defaultContentType": "application/json",
  "servers": {
    "pagixKafka": {
      "host": "kafka.internal.pagix.dev:9092",
      "protocol": "kafka",
      "description": "Pagix business event transport."
    }
  },
  "channels": {
    "targetSnapshots": {
      "address": "pagix.agent.target-snapshots.v1",
      "messages": {
        "TargetSnapshot": {
          "$ref": "#/components/messages/TargetSnapshot"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "target.targetId",
      "x-anvilkit-delivery": "at-least-once"
    },
    "usageObservations": {
      "address": "pagix.agent.usage-observations.v1",
      "messages": {
        "UsageObservation": {
          "$ref": "#/components/messages/UsageObservation"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "rootRunId",
      "x-anvilkit-delivery": "at-least-once"
    },
    "domainDlq": {
      "address": "pagix.agent.dlq.v1",
      "messages": {
        "ProblemDetails": {
          "$ref": "#/components/messages/ProblemDetails"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "runId",
      "x-anvilkit-delivery": "at-least-once"
    }
  },
  "operations": {
    "publishTargetSnapshots": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/targetSnapshots"
      },
      "messages": [
        {
          "$ref": "#/channels/targetSnapshots/messages/TargetSnapshot"
        }
      ],
      "description": "Pagix publishes immutable target snapshot facts."
    },
    "consumeTargetSnapshots": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/targetSnapshots"
      },
      "messages": [
        {
          "$ref": "#/channels/targetSnapshots/messages/TargetSnapshot"
        }
      ],
      "description": "Agent Service reconciles the authoritative target revision."
    },
    "consumeUsageObservations": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/usageObservations"
      },
      "messages": [
        {
          "$ref": "#/channels/usageObservations/messages/UsageObservation"
        }
      ],
      "description": "Pagix records every physical attempt additively."
    },
    "consumeDomainDlq": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/domainDlq"
      },
      "messages": [
        {
          "$ref": "#/channels/domainDlq/messages/ProblemDetails"
        }
      ],
      "description": "Operators consume stable bounded domain errors."
    }
  },
  "components": {
    "messages": {
      "TargetSnapshot": {
        "name": "TargetSnapshotV1",
        "title": "TargetSnapshotV1 message",
        "summary": "Bounded TargetSnapshotV1 payload.",
        "contentType": "application/json",
        "headers": {
          "type": "object",
          "required": [
            "messageId",
            "traceparent"
          ],
          "properties": {
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "traceparent": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            }
          },
          "additionalProperties": false
        },
        "payload": {
          "$ref": "anvilkit://schema/target-snapshot.v1@1.0.0?digest=sha256:89d75fa6d287eea5b21208bfcaae4a8e639debf2e4a7dfad322805ec13ed41c2"
        },
        "correlationId": {
          "description": "Trace correlation.",
          "location": "$message.header#/traceparent"
        },
        "bindings": {
          "kafka": {
            "key": {
              "type": "string",
              "description": "Partition key is target.targetId."
            },
            "bindingVersion": "0.5.0"
          }
        },
        "x-anvilkit-byteStableMessageId": true
      },
      "UsageObservation": {
        "name": "UsageObservationV1",
        "title": "UsageObservationV1 message",
        "summary": "Bounded UsageObservationV1 payload.",
        "contentType": "application/json",
        "headers": {
          "type": "object",
          "required": [
            "messageId",
            "traceparent"
          ],
          "properties": {
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "traceparent": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            }
          },
          "additionalProperties": false
        },
        "payload": {
          "$ref": "anvilkit://schema/usage-observation.v1@1.0.0?digest=sha256:929bb6dd41798113a64664f83397e7e2b642ea37133698d03041c4ede397c68a"
        },
        "correlationId": {
          "description": "Trace correlation.",
          "location": "$message.header#/traceparent"
        },
        "bindings": {
          "kafka": {
            "key": {
              "type": "string",
              "description": "Partition key is rootRunId."
            },
            "bindingVersion": "0.5.0"
          }
        },
        "x-anvilkit-byteStableMessageId": true
      },
      "ProblemDetails": {
        "name": "ProblemDetailsV1",
        "title": "ProblemDetailsV1 message",
        "summary": "Bounded ProblemDetailsV1 payload.",
        "contentType": "application/json",
        "headers": {
          "type": "object",
          "required": [
            "messageId",
            "traceparent"
          ],
          "properties": {
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "traceparent": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            }
          },
          "additionalProperties": false
        },
        "payload": {
          "$ref": "anvilkit://schema/problem-details.v1@1.0.0?digest=sha256:6cfe1db66717fb64fd1ec18920ec64b16c191c2ba6a4009350ba4a19163b7647"
        },
        "correlationId": {
          "description": "Trace correlation.",
          "location": "$message.header#/traceparent"
        },
        "bindings": {
          "kafka": {
            "key": {
              "type": "string",
              "description": "Partition key is runId."
            },
            "bindingVersion": "0.5.0"
          }
        },
        "x-anvilkit-byteStableMessageId": true
      }
    }
  },
  "x-anvilkit-ordering": {
    "delivery": "at-least-once",
    "duplicates": "same message ID must have byte-identical content",
    "maximumPayloadBytes": 32768,
    "largeContent": "AgentArtifactV1 reference"
  }
}
