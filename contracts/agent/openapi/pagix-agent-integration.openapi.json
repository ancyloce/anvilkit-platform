          {
            "workloadIdentity": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestDigest"
          },
          {
            "$ref": "#/components/parameters/Traceparent"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/BoundedStringMap"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable snapshot bound to catalog, policy, and Contract BOM digests.",
            "headers": {
              "Idempotency-Replayed": {
                "description": "true when a recorded semantic outcome is replayed.",
                "schema": {
                  "type": "boolean"
