            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "traceparent": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            }
          },
          "additionalProperties": false
        },
        "payload": {
          "$ref": "anvilkit://schema/agent-event?digest=sha256:2fdd8937381427507e721675ebbd66144595a193b53ba460534e9712df9b774a"
        },
