{
  "asyncapi": "3.1.0",
  "info": {
    "title": "AnvilKit Agent events",
    "version": "p0-kernel",
    "description": "Canonical Kafka binding for public AgentEvent projections and internal worker/usage transport (ADR-020). Producer and consumer owner acknowledgement is pending.",
    "x-anvilkit-ownerAcknowledgement": "pending"
  },
  "defaultContentType": "application/json",
  "servers": {
    "candidateKafka": {
      "host": "kafka.internal.anvilkit.dev:9092",
      "protocol": "kafka",
      "description": "Candidate Agent event transport.",
      "x-anvilkit-ownerAcknowledgement": "pending"
    }
  },
  "channels": {
    "publicEvents": {
      "address": "anvilkit.agent.public-events",
      "messages": {
        "AgentEvent": {
          "$ref": "#/components/messages/AgentEvent"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "runId",
      "x-anvilkit-delivery": "at-least-once"
    },
    "workerTasks": {
      "address": "anvilkit.agent.worker-tasks",
      "messages": {
        "AgentTask": {
          "$ref": "#/components/messages/AgentTask"
        },
        "WorkerLease": {
          "$ref": "#/components/messages/WorkerLease"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "taskId",
      "x-anvilkit-delivery": "at-least-once"
    },
    "workerResults": {
      "address": "anvilkit.agent.worker-results",
      "messages": {
        "WorkerResult": {
          "$ref": "#/components/messages/WorkerResult"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "taskId",
      "x-anvilkit-delivery": "at-least-once"
    },
    "usageObservations": {
      "address": "anvilkit.agent.usage-observations",
      "messages": {
        "UsageObservation": {
          "$ref": "#/components/messages/UsageObservation"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "rootRunId",
      "x-anvilkit-delivery": "at-least-once"
    },
    "dlq": {
      "address": "anvilkit.agent.dlq",
      "messages": {
        "ProblemDetails": {
          "$ref": "#/components/messages/ProblemDetails"
        }
      },
      "bindings": {
        "kafka": {
          "topicConfiguration": {
            "cleanupPolicy": [
              "delete"
            ]
          },
          "bindingVersion": "0.5.0"
        }
      },
      "x-anvilkit-partitionKey": "runId",
      "x-anvilkit-delivery": "at-least-once"
    }
  },
  "operations": {
    "publishPublicEvents": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/publicEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/publicEvents/messages/AgentEvent"
        }
      ],
      "description": "Agent Service publishes only the six registered public lifecycle projections with continuous per-run sequence."
    },
    "consumePublicEvents": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/publicEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/publicEvents/messages/AgentEvent"
        }
      ],
      "description": "Consumers resume from the durable public cursor only."
    },
    "dispatchWorkerTasks": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/workerTasks"
      },
      "messages": [
        {
          "$ref": "#/channels/workerTasks/messages/AgentTask"
        },
        {
          "$ref": "#/channels/workerTasks/messages/WorkerLease"
        }
      ],
      "description": "Agent Service dispatches fenced, leased worker tasks."
    },
    "consumeWorkerTasks": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/workerTasks"
      },
      "messages": [
        {
          "$ref": "#/channels/workerTasks/messages/AgentTask"
        },
        {
          "$ref": "#/channels/workerTasks/messages/WorkerLease"
        }
      ],
      "description": "Workers consume tasks and leases with at-least-once delivery."
    },
    "publishWorkerResults": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/workerResults"
      },
      "messages": [
        {
          "$ref": "#/channels/workerResults/messages/WorkerResult"
        }
      ],
      "description": "Workers publish fenced results; stale fences cannot commit state."
    },
    "consumeWorkerResults": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/workerResults"
      },
      "messages": [
        {
          "$ref": "#/channels/workerResults/messages/WorkerResult"
        }
      ],
      "description": "Agent Service consumes and fences worker results."
    },
    "publishUsage": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/usageObservations"
      },
      "messages": [
        {
          "$ref": "#/channels/usageObservations/messages/UsageObservation"
        }
      ],
      "description": "Every physical attempt publishes additive usage exactly once per meter sequence."
    },
    "consumeUsage": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/usageObservations"
      },
      "messages": [
        {
          "$ref": "#/channels/usageObservations/messages/UsageObservation"
        }
      ],
      "description": "The usage ledger consumes additive observations."
    },
    "consumeDlq": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/dlq"
      },
      "messages": [
        {
          "$ref": "#/channels/dlq/messages/ProblemDetails"
        }
      ],
      "description": "Operators consume dead-lettered problems."
    }
  },
  "components": {
    "messages": {
