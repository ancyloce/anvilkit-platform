{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.anvilkit.dev/agent/fixtures/manifest.schema.json",
  "title": "AnvilKit canonical Agent fixture manifest",
  "description": "Byte-exact conformance manifest for the canonical Agent fixture corpus. Generated deterministically by check-agent-contracts.ts --update-manifest.",
  "type": "object",
  "required": ["manifestVersion", "status", "description", "cases", "relationships"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": {"const": 1},
    "status": {"const": "canonical"},
    "description": {"type": "string", "minLength": 1, "maxLength": 512},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/case"}
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/relationship"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "case": {
      "type": "object",
      "required": ["id", "path", "bytesSha256", "bytesLength", "schema", "category", "tags", "expected", "applicableLanguages", "synthetic"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "path": {"type": "string", "pattern": "^contracts/agent/fixtures/(valid|invalid|adversarial)/[A-Za-z0-9.-]+\\.json$"},
        "bytesSha256": {"$ref": "#/$defs/digest"},
        "bytesLength": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "schema": {
          "type": "object",
          "required": ["logicalId", "path", "logicalUri", "digest"],
          "additionalProperties": false,
          "properties": {
            "logicalId": {"type": "string", "minLength": 3, "maxLength": 128},
            "path": {"type": "string", "minLength": 1, "maxLength": 256},
            "logicalUri": {"type": "string", "minLength": 1, "maxLength": 512},
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        "category": {"enum": ["minimum", "full", "maximum-bound", "invalid", "adversarial"]},
        "tags": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "expected": {
          "type": "object",
          "required": ["parse", "valid", "findings", "canonicalization", "signature"],
          "additionalProperties": false,
          "properties": {
            "parse": {"enum": ["accepted", "rejected"]},
            "valid": {"type": "boolean"},
            "findings": {
              "type": "array",
              "minItems": 0,
              "maxItems": 128,
              "items": {
                "type": "object",
                "required": ["code", "instancePath", "schemaPath"],
                "additionalProperties": false,
                "properties": {
                  "code": {"type": "string", "minLength": 1, "maxLength": 96},
                  "instancePath": {"type": "string", "minLength": 1, "maxLength": 512},
                  "schemaPath": {"type": "string", "minLength": 1, "maxLength": 512}
                }
              }
            },
            "canonicalization": {"const": "jcs"},
            "signature": {"const": "not-applicable"}
          }
        },
        "applicableLanguages": {"const": ["tooling", "go", "typescript"]},
        "synthetic": {"const": true}
      }
    },
    "relationship": {
      "type": "object",
      "required": ["id", "rule", "fixtures", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "rule": {"type": "string", "minLength": 1, "maxLength": 256},
        "fixtures": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "expected": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  }
}
