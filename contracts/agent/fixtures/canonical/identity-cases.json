      "value": {
        "type": "object",
        "$id": "https://contracts.anvilkit.dev/example.schema.json"
      },
      "purpose": "schema",
      "mediaType": "application/schema+json",
      "expectedDigest": "sha256:d2ac6760e4e1ff8dad734f00a0ce58bf16fbc86ac3393332fa6439cf010a0acd"
    },
    {
      "id": "cross-purpose-domain-separation",
      "value": {
        "$id": "https://contracts.anvilkit.dev/example.schema.json",
        "type": "object"
      },
      "purpose": "action",
      "mediaType": "application/schema+json",
