  ],
  "bomCases": [
    {
      "id": "root-digest-omits-exactly-digest",
      "value": {
        "kind": "ContractBom",
        "name": "platform-kernel",
        "digest": "sha256:274643d684210bd8a1f3900e51d0f6071bc371902be6fe7b8570c786d4d38379",
        "createdAt": "2026-08-08T00:00:00.000Z",
        "issuer": "urn:anvilkit:issuer:contracts-release",
        "components": [],
        "registrySetDigest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
        "profileDigest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      "expectedDigest": "sha256:274643d684210bd8a1f3900e51d0f6071bc371902be6fe7b8570c786d4d38379",
      "expectedVerification": true,
      "expectedCanonicalWithoutDigest": "{\"components\":[],\"createdAt\":\"2026-08-08T00:00:00.000Z\",\"issuer\":\"urn:anvilkit:issuer:contracts-release\",\"kind\":\"ContractBom\",\"name\":\"platform-kernel\",\"profileDigest\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"registrySetDigest\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\"}"
    },
    {
      "id": "declared-digest-mismatch",
      "copyOf": "root-digest-omits-exactly-digest",
      "declaredDigest": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "expectedDigest": "sha256:274643d684210bd8a1f3900e51d0f6071bc371902be6fe7b8570c786d4d38379",
      "expectedVerification": false
    },
    {
      "id": "missing-declared-digest-rejected",
      "value": {
        "kind": "ContractBom"
      },
      "expectedCode": "BOM_DIGEST_MISSING"
    }
  ]
