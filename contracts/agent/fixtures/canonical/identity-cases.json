{
  "corpusVersion": 1,
  "status": "canonical",
  "profiles": [
    "RFC8785",
    "ComponentIdentityV1",
    "ContractBomIdentityV1"
  ],
  "description": "Canonical JCS canonical-byte and domain-separated identity vectors shared by the Go and TypeScript consumers. Synthetic review inputs, not release identities.",
  "applicableLanguages": [
    "go",
    "typescript"
  ],
  "jcsCases": [
    {
      "id": "rfc8785-primitive-serialization",
      "value": {
        "numbers": [
          333333333.3333333,
          1e+30,
          4.5,
          0.002,
          1e-27
        ],
        "string": "€$\u000f\nA'B\"\\\\\"/",
        "literals": [
          null,
          true,
          false
        ]
      },
      "expectedCanonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}"
    },
    {
      "id": "rfc8785-utf16-property-order",
      "value": {
        "1": "One",
        "€": "Euro Sign",
        "\r": "Carriage Return",
        "דּ": "Hebrew Letter Dalet With Dagesh",
        "😀": "Emoji: Grinning Face",
        "": "Control",
        "ö": "Latin Small Letter O With Diaeresis"
      },
      "expectedCanonical": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\":\"Control\",\"ö\":\"Latin Small Letter O With Diaeresis\",\"€\":\"Euro Sign\",\"😀\":\"Emoji: Grinning Face\",\"דּ\":\"Hebrew Letter Dalet With Dagesh\"}"
    },
    {
      "id": "unicode-preserved-and-nested-objects-sorted",
      "value": {
        "é": "composed",
        "é": "decomposed",
        "nested": [
          {
            "z": 0,
            "a": 1
          }
        ]
      },
      "expectedCanonical": "{\"é\":\"decomposed\",\"nested\":[{\"a\":1,\"z\":0}],\"é\":\"composed\"}"
    },
    {
      "id": "reject-negative-zero-programmatic-value",
      "value": {
        "value": -0
      },
      "expectedCode": "JCS_NEGATIVE_ZERO"
    },
    {
      "id": "reject-unpaired-surrogate-programmatic-value",
      "value": {
        "value": "\ud800"
      },
      "expectedCode": "JCS_INVALID_UNICODE"
    }
  ],
  "componentCases": [
